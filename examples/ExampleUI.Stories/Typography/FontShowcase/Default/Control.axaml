<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:ExampleUI.Stories.Typography.FontShowcase.Default"
             x:Class="ExampleUI.Stories.Typography.FontShowcase.Default.Control"
             x:DataType="local:Story">
    <StackPanel Spacing="16" HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel Spacing="4">
            <TextBlock Text="Noto Mono (embedded, registered at startup)" FontSize="11" Foreground="#666" />
            <TextBlock x:Name="EmbeddedSample"
                       Text="{Binding SampleText}"
                       FontSize="{Binding SampleFontSize}"
                       FontFamily="fonts:ExampleUI#Noto Mono"
                       Foreground="#1B1B1F"
                       TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel Spacing="4">
            <TextBlock Text="Default font, for comparison" FontSize="11" Foreground="#666" />
            <TextBlock Text="{Binding SampleText}"
                       FontSize="{Binding SampleFontSize}"
                       Foreground="#1B1B1F"
                       TextWrapping="Wrap" />
        </StackPanel>
    </StackPanel>
</UserControl>
