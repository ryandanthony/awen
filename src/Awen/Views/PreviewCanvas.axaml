<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Awen.ViewModels"
             xmlns:conv="using:Awen.Converters"
             x:Class="Awen.Views.PreviewCanvas"
             x:DataType="vm:PreviewViewModel">
    <UserControl.Resources>
        <conv:InfinityToNaNConverter x:Key="InfinityToNaN" />
    </UserControl.Resources>
    <UserControl.Styles>
        <!-- Error view buttons use Awen's own colors, not the preview theme variant. -->
        <Style Selector=":is(Button).error-action">
            <Setter Property="Background" Value="{DynamicResource LightSurfaceVariant}" />
            <Setter Property="Foreground" Value="{DynamicResource LightText}" />
            <Setter Property="BorderBrush" Value="{DynamicResource LightBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="16,4" />
            <Setter Property="MinWidth" Value="88" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
        <Style Selector=":is(Button).error-action:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource LightBorder}" />
            <Setter Property="Foreground" Value="{DynamicResource LightText}" />
        </Style>
        <Style Selector="ToggleButton.error-action:checked /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource LightBorder}" />
            <Setter Property="Foreground" Value="{DynamicResource LightText}" />
        </Style>
    </UserControl.Styles>
    <ThemeVariantScope x:Name="PART_ThemeScope" RequestedThemeVariant="{Binding ThemeVariant}">
        <Panel Background="{DynamicResource CanvasOuterBackground}">
            <!-- Empty state: no story selected -->
            <StackPanel VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Spacing="8"
                        IsVisible="{Binding SelectedStory, Converter={x:Static ObjectConverters.IsNull}}">
                <TextBlock Text="👀"
                           FontSize="32"
                           HorizontalAlignment="Center" />
                <TextBlock Text="Select a story to preview"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"
                           Foreground="{DynamicResource LightTextSecondary}"
                           FontSize="13" />
                <TextBlock Text="Choose a component from the left sidebar"
                           HorizontalAlignment="Center"
                           Foreground="{DynamicResource LightTextTertiary}"
                           FontSize="11"
                           Opacity="0.7" />
            </StackPanel>

            <!-- Error state: the story failed to load or threw while running. Awen keeps running. -->
            <ScrollViewer x:Name="PART_ErrorView"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          IsVisible="{Binding HasError}"
                          Padding="24">
                <StackPanel VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Spacing="12"
                            MaxWidth="720">
                    <TextBlock Text="⚠️ This story threw an error"
                               FontWeight="Bold"
                               Foreground="{DynamicResource ColorError}"
                               FontSize="16"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding ErrorSource}"
                               Foreground="{DynamicResource LightTextSecondary}"
                               FontSize="12"
                               HorizontalAlignment="Center" />
                    <Border Background="{DynamicResource LightBackground}"
                            BorderBrush="{DynamicResource ColorError}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="16">
                        <SelectableTextBlock x:Name="PART_ErrorMessage"
                                             Text="{Binding ErrorMessage}"
                                             TextWrapping="Wrap"
                                             Foreground="{DynamicResource ColorError}"
                                             FontFamily="Cascadia Mono, Consolas, monospace"
                                             FontSize="13"
                                             LineHeight="20" />
                    </Border>
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                Spacing="8">
                        <Button x:Name="PART_RetryButton"
                                Classes="error-action"
                                Content="Retry"
                                Command="{Binding RetryCommand}" />
                        <ToggleButton x:Name="PART_DetailsToggle"
                                      Classes="error-action"
                                      Content="Details"
                                      IsVisible="{Binding ErrorDetails, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    </StackPanel>
                    <Border Background="{DynamicResource LightBackground}"
                            BorderBrush="{DynamicResource LightBorder}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="12"
                            IsVisible="{Binding #PART_DetailsToggle.IsChecked}">
                        <SelectableTextBlock Text="{Binding ErrorDetails}"
                                             TextWrapping="Wrap"
                                             Foreground="{DynamicResource ColorError}"
                                             FontFamily="Cascadia Mono, Consolas, monospace"
                                             FontSize="11"
                                             LineHeight="16" />
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Normal preview content with viewport constraints -->
            <Border x:Name="PART_PreviewBorder"
                    IsVisible="{Binding !HasError}"
                    Width="{Binding ViewportWidth, Converter={StaticResource InfinityToNaN}}"
                    Height="{Binding ViewportHeight, Converter={StaticResource InfinityToNaN}}"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Background="#FFFFFF"
                    CornerRadius="4"
                    BoxShadow="0 4 32 8 #50000000">
                <DockPanel>
                    <!-- Description at bottom -->
                    <Border DockPanel.Dock="Bottom"
                            Background="{DynamicResource LightSurface}"
                            BorderBrush="{DynamicResource LightBorder}"
                            BorderThickness="0,1,0,0"
                            Padding="12,8"
                            IsVisible="{Binding Description, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                        <TextBlock Text="{Binding Description}"
                                   Foreground="{DynamicResource LightTextSecondary}"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   LineHeight="1.4" />
                    </Border>

                    <!-- Preview control fills available space, scrollable when content overflows -->
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto">
                        <ContentControl Content="{Binding PreviewContent}"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Stretch"
                                        Margin="12" />
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Panel>
    </ThemeVariantScope>
</UserControl>
